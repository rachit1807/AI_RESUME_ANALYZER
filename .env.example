# Generate a private random value before deployment; never commit real secrets.
SESSION_SECRET=change-me-to-a-long-random-secret
# Local only: set false when running over plain HTTP at 127.0.0.1.
COOKIE_SECURE=false
# Optional. Without DATABASE_URL, local SQLite is used. Production should use PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Optional report email delivery (server-side SMTP credentials only).
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-user
# MAIL_PASSWORD=your-smtp-app-password
# MAIL_FROM=reports@example.com
# MAIL_USE_TLS=true
